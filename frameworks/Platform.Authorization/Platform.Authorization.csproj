<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Platform.Authorization</PackageId>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- Phân quyền core: model + engine, KHÔNG phụ thuộc EF Core hay store user (xem Platform.Authorization.EntityFramework). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="9.0.20" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Platform.Authorization.EntityFramework" />
    <InternalsVisibleTo Include="UnitTest" />
  </ItemGroup>

</Project>
