<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Platform.Multitenancy.EntityFramework</PackageId>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Multitenancy\Platform.Multitenancy.csproj" />
    <ProjectReference Include="..\Platform.ORM.EntityFramework\Platform.ORM.EntityFramework.csproj" />
  </ItemGroup>

</Project>
