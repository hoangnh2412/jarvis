<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Platform.Host</PackageId>
    <AssemblyName>Platform.Host</AssemblyName>
    <RootNamespace>Platform.Host</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Authentication.Identity\Platform.Authentication.Identity.csproj" />
    <ProjectReference Include="..\Platform.Authorization.EntityFramework\Platform.Authorization.EntityFramework.csproj" />
    <ProjectReference Include="..\Platform.DDD.Application\Platform.DDD.Application.csproj" />
    <ProjectReference Include="..\Platform.DDD.Domain\Platform.DDD.Domain.csproj" />
    <ProjectReference Include="..\Platform.Multitenancy\Platform.Multitenancy.csproj" />
    <ProjectReference Include="..\Platform.ORM.EntityFramework\Platform.ORM.EntityFramework.csproj" />
    <ProjectReference Include="..\..\modules\identity\Platform.Modules.IdentityAdmin\Platform.Modules.IdentityAdmin.csproj" />
    <ProjectReference Include="..\..\modules\identity\Platform.Modules.IdentityAdmin.Api\Platform.Modules.IdentityAdmin.Api.csproj" />
    <ProjectReference Include="..\..\modules\identity\Platform.Modules.Account\Platform.Modules.Account.csproj" />
    <ProjectReference Include="..\..\modules\identity\Platform.Modules.Account.Api\Platform.Modules.Account.Api.csproj" />
    <ProjectReference Include="..\..\modules\orgs\Platform.Orgs\Platform.Orgs.csproj" />
    <ProjectReference Include="..\..\modules\orgstructure\Platform.OrgStructure\Platform.OrgStructure.csproj" />
    <ProjectReference Include="..\..\modules\orgstructure\Platform.OrgStructure.Api\Platform.OrgStructure.Api.csproj" />
    <ProjectReference Include="..\..\modules\orgstructure\Platform.OrgStructure.EntityFramework\Platform.OrgStructure.EntityFramework.csproj" />
    <ProjectReference Include="..\..\modules\tenants\Platform.Tenants\Platform.Tenants.csproj" />
    <ProjectReference Include="..\..\modules\tenants\Platform.Tenants.EntityFramework\Platform.Tenants.EntityFramework.csproj" />
