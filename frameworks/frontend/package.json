{
  "name": "@platform/core",
  "version": "0.1.0",
  "description": "Reusable UI kit on PrimeReact 11 (Account, CRUD, Tenant, common helpers)",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./src/styles/theme.css",
    "./src/styles/kit.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./src/styles/theme.css",
    "./styles.css": "./src/styles/kit.css",
    "./sources.css": "./src/styles/sources.css",
    "./tailwind.preset.cjs": "./tailwind.preset.cjs",
    "./tailwind.config.cjs": "./tailwind.config.cjs",
    "./vite/react": "./vite/plugins/reactPlugin.ts",
    "./vite/draggableDebug": "./vite/plugins/draggableDebugPlugin.ts",
    "./vite/nodeEnv": "./vite/plugins/nodeEnvPlugin.ts",
    "./vite/hostEnv": "./vite/hostEnv.ts",
    "./vite/hostProxy": "./vite/hostProxy.ts",
    "./vite/hostResolve": "./vite/hostResolve.ts",
    "./vite/platformModules": "./vite/platformModules.ts"
  },
  "files": [
    "dist",
    "src/styles",
    "tailwind.preset.cjs",
    "tailwind.config.cjs",
    "postcss.config.cjs",
    "vite",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.5.0",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": ">=1.0.0",
    "@hookform/resolvers": "^5.4.0",
    "@primereact/core": "^11.0.0",
    "@primereact/headless": "^11.0.0",
    "@primeuix/styled": "^1.0.0",
    "@primeuix/themes": "^3.0.0",
    "@react-querybuilder/dnd": "^8.22.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axios": "^1.19.0",
    "docx-preview": "^0.4.0",
    "pizzip": "^3.2.0",
    "lucide-react": "^1.28.0",
    "primeicons": "^8.0.0",
    "primereact": "^11.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-querybuilder": "^8.22.0",
    "react-router-dom": "^7.18.1",
    "react-toastify": "^11.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "keywords": [
    "react",
    "ui",
    "ui-kit",
    "primereact",
    "crud",
    "tenant",
    "form",
    "query-builder",
    "tailwind"
  ],
  "publishConfig": {
    "access": "public"
  }
}
