{
  "name": "@jarvis/core",
  "version": "0.1.0",
  "description": "Reusable UI kit on PrimeReact 11 (Account, CRUD, Tenant, CraftPdf, Dashboard, common helpers)",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "./src/styles/theme.css",
    "./src/styles/kit.css",
    "./src/features/craftPdf/utils/ensureBrowserProcess.ts",
    "./src/features/dashboard/styles/dashboard.css",
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./src/styles/theme.css",
    "./styles.css": "./src/styles/kit.css",
    "./sources.css": "./src/styles/sources.css",
    "./dashboard.css": "./src/features/dashboard/styles/dashboard.css",
    "./tailwind.preset.cjs": "./tailwind.preset.cjs",
    "./tailwind.config.cjs": "./tailwind.config.cjs"
  },
  "files": [
    "dist",
    "src/styles",
    "tailwind.preset.cjs",
    "tailwind.config.cjs",
    "postcss.config.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
