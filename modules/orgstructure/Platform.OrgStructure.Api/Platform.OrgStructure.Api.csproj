<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Platform.OrgStructure.Api</PackageId>
    <AssemblyName>Platform.OrgStructure.Api</AssemblyName>
    <RootNamespace>Platform.OrgStructure.Api</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.OrgStructure\Platform.OrgStructure.csproj" />
    <ProjectReference Include="..\..\identity\Platform.Modules.IdentityAdmin\Platform.Modules.IdentityAdmin.csproj" />
    <ProjectReference Include="..\..\tenants\Platform.Tenants\Platform.Tenants.csproj" />
    <ProjectReference Include="..\..\orgs\Platform.Orgs\Platform.Orgs.csproj" />
  </ItemGroup>

</Project>
