<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Platform.Modules.Files.API</PackageId>
    <AssemblyName>Platform.Modules.Files.API</AssemblyName>
    <RootNamespace>Platform.Modules.Files.API</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Modules.Files\Platform.Modules.Files.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Platform.BlobStoring\Platform.BlobStoring.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Platform.BlobStoring.SharePoint\Platform.BlobStoring.SharePoint.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Platform.BlobStoring.Synology\Platform.BlobStoring.Synology.csproj" />
  </ItemGroup>

</Project>
