# ImportExport FE shell — copy to .env (or .env.local)
VITE_IMPORT_EXPORT_API_URL=/ie-api
# Must match Security:ApiKey in Api host (dev default: dev-importexport-key)
VITE_IMPORT_EXPORT_API_KEY=dev-importexport-key
# Must be listed in Security:AllowedTenantIds for that API key
VITE_TENANT_ID=00000000-0000-0000-0000-000000000001
