<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Platform.Modules.Account</PackageId>
    <AssemblyName>Platform.Modules.Account</AssemblyName>
    <RootNamespace>Platform.Modules.Account</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- ADR C12/T13: Account depends on Authentication only — never on Platform.Authorization. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\frameworks\Platform.DDD.Application\Platform.DDD.Application.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Platform.DDD.Application.Contracts\Platform.DDD.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Platform.Authentication\Platform.Authentication.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Platform.Authentication.Identity\Platform.Authentication.Identity.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Platform.Authentication.Jwt\Platform.Authentication.Jwt.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTest" />
  </ItemGroup>

</Project>
