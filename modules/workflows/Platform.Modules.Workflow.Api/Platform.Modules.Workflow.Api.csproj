<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	<PackageId>Platform.Modules.ElsaWorkflow.Api</PackageId>
	<AssemblyName>Platform.Modules.ElsaWorkflow.Api</AssemblyName>
	<RootNamespace>Platform.Modules.ElsaWorkflow.Api</RootNamespace>
	<Version>1.0.0</Version>
	<Authors>Danh Vuong</Authors>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<TargetFramework>net9.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <PropertyGroup>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Elsa.Studio" Version="3.7.1" />
	<PackageReference Include="Elsa.Studio.Core" Version="3.7.1" />
	<PackageReference Include="Elsa.Studio.Core.BlazorServer" Version="3.7.1" />
	<PackageReference Include="Elsa.Studio.Workflows" Version="3.7.1" />
	<PackageReference Include="Elsa.Studio.Workflows.Designer" Version="3.7.1" />
	<PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="7.2.0" />

	<ProjectReference Include="..\Platform.Modules.Workflow\Platform.Modules.Workflow.csproj" />
	<ProjectReference Include="..\..\..\frameworks\Platform.Workflow\Platform.Workflow.csproj" />
		<ProjectReference Include="..\..\..\frameworks\Platform.DDD.Domain\Platform.DDD.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\js\" />
  </ItemGroup>

</Project>
