    <link href="_content/Platform.Modules.ElsaWorkflow.Api/css/elsa-embedded.css" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <div class="my-application">
        <div class="app-body">
            <main class="app-content">
                <div class="elsa-embedded">
                    <component type="typeof(Elsa.Studio.Shell.App)" render-mode="Server" />
