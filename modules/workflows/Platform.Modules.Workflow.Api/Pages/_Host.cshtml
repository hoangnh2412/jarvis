    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_content/CodeBeam.MudBlazor.Extensions/MudExtensions.min.js"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
    @* <script>
        window.mudElementRef ??= {};
        window.mudElementRef.getBoundingClientRect ??= element => element.getBoundingClientRect();
        window.mudElementRef.addOnBlurEvent ??= (element, dotNetReference) => {
            if (!element) return;
            element._mudBlurHandler = event => {
                if (!document.contains(element)) {
                    window.mudElementRef.removeOnBlurEvent(element);
                    return;
                }

                event.preventDefault();
                dotNetReference?.invokeMethodAsync("CallOnBlurredAsync");
            };
            element.addEventListener("blur", element._mudBlurHandler);
        };
        window.mudElementRef.removeOnBlurEvent ??= element => {
            if (!element?._mudBlurHandler) return;
