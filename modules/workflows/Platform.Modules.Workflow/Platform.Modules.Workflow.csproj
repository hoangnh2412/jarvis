<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<PackageId>Platform.Modules.ElsaWorkflow</PackageId>
	<AssemblyName>Platform.Modules.ElsaWorkflow</AssemblyName>
	<RootNamespace>Platform.Modules.ElsaWorkflow</RootNamespace>
	<Version>1.0.0</Version>
	<Authors>Danh Vuong</Authors>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<TargetFramework>net9.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\..\frameworks\Platform.Workflow\Platform.Workflow.csproj" />
  </ItemGroup>

</Project>
