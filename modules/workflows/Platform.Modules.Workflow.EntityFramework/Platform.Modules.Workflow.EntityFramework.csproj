<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<PackageId>Platform.Modules.ElsaWorkflow.EntityFramework</PackageId>
	<AssemblyName>Platform.Modules.ElsaWorkflow.EntityFramework</AssemblyName>
	<RootNamespace>Platform.Modules.ElsaWorkflow.EntityFramework</RootNamespace>
	<Version>1.0.0</Version>
	<Authors>Danh Vuong</Authors>
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	<TargetFramework>net9.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
	<NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
	<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.20" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\Platform.Modules.Workflow\Platform.Modules.Workflow.csproj" />
	<ProjectReference Include="..\..\..\frameworks\Platform.Workflow\Platform.Workflow.csproj" />
  </ItemGroup>

</Project>
