{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MasterDbContext": "Host=localhost;Port=5432;User ID=admin;Password=Admin@123;Database=SampleMaster;Pooling=true;",
    "AutoMigrate": true
  },
  "Cache": {
    "DistributedGroups": {
      "Redis": {
        "Default": {
          "Configuration": "127.0.0.1:6379",
          "InstanceName": "PlatformWorkflow_"
        }
      }
    }
  },
  "Elsa": {
    "ConnectionStringName": "MasterDbContext",
    "PersistenceSchema": "elsa",
    "ApiPathPrefix": "/elsa/api"
  },
  "Workflow": {
    "Redis": {
      "Enabled": true,
      "KeyPrefix": "elsaworkflow",
      "NodeInfoTtl": "30.00:00:00",
      "IdempotencyTtl": "1.00:00:00"
    }
  }
}
