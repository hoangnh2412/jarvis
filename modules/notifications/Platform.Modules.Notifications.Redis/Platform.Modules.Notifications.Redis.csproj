<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Platform.Modules.Notifications.Redis</PackageId>
    <AssemblyName>Platform.Modules.Notifications.Redis</AssemblyName>
    <RootNamespace>Platform.Modules.Notifications.Redis</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Platform.Modules.Notifications\Platform.Modules.Notifications.csproj" />
    <ProjectReference Include="..\..\settings\Platform.Modules.Setting\Platform.Modules.Setting.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Platform.Realtime\Platform.Realtime.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Platform.Caching\Platform.Caching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.7.33" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTest" />
  </ItemGroup>

</Project>
