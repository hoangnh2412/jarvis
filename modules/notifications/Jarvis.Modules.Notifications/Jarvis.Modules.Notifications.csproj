<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Jarvis.Modules.Notifications</PackageId>
    <AssemblyName>Jarvis.Modules.Notifications</AssemblyName>
    <RootNamespace>Jarvis.Modules.Notifications</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\frameworks\Jarvis.DDD.Domain\Jarvis.DDD.Domain.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Jarvis.DDD.Application.Contracts\Jarvis.DDD.Application.Contracts.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Jarvis.Realtime\Jarvis.Realtime.csproj" />
    <ProjectReference Include="..\..\settings\Jarvis.Modules.Setting\Jarvis.Modules.Setting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTest" />
    <InternalsVisibleTo Include="Jarvis.Modules.Notifications.Redis" />
    <InternalsVisibleTo Include="Jarvis.Realtime.SignalR" />
  </ItemGroup>

</Project>
