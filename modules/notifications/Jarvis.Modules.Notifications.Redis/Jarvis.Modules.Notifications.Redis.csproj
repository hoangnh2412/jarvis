<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Jarvis.Modules.Notifications.Redis</PackageId>
    <AssemblyName>Jarvis.Modules.Notifications.Redis</AssemblyName>
    <RootNamespace>Jarvis.Modules.Notifications.Redis</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jarvis.Modules.Notifications\Jarvis.Modules.Notifications.csproj" />
    <ProjectReference Include="..\..\settings\Jarvis.Modules.Setting\Jarvis.Modules.Setting.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Jarvis.Realtime\Jarvis.Realtime.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Jarvis.Caching\Jarvis.Caching.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" Version="2.7.33" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTest" />
  </ItemGroup>

</Project>
