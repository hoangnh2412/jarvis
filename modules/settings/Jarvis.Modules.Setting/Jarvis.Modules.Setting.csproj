<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Jarvis.Modules.Setting</PackageId>
    <AssemblyName>Jarvis.Modules.Setting</AssemblyName>
    <RootNamespace>Jarvis.Modules.Setting</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\frameworks\Jarvis.Caching\Jarvis.Caching.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Jarvis.Common\Jarvis.Common.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Jarvis.DDD.Domain\Jarvis.DDD.Domain.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Jarvis.DDD.Domain.Shared\Jarvis.DDD.Domain.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UnitTest" />
  </ItemGroup>

</Project>
