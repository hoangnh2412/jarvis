<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Jarvis.Modules.Setting.EntityFramework</PackageId>
    <AssemblyName>Jarvis.Modules.Setting.EntityFramework</AssemblyName>
    <RootNamespace>Jarvis.Modules.Setting.EntityFramework</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Hoang Nguyen</Authors>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.15" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.15" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jarvis.Modules.Setting\Jarvis.Modules.Setting.csproj" />
    <ProjectReference Include="..\..\..\frameworks\Jarvis.DDD.Domain\Jarvis.DDD.Domain.csproj" />
  </ItemGroup>

</Project>
