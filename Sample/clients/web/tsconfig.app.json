{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@platform/core": ["../../../frameworks/frontend/src/index.ts"],
      "@platform/core/*": ["../../../frameworks/frontend/src/*"],
      "@platform/notifications": [
        "../../../modules/notifications/frontend/src/features/notifications/index.ts"
      ],
      "@platform/setting": ["../../../modules/settings/frontend/src/index.ts"],
      "@platform/setting/*": ["../../../modules/settings/frontend/src/*"],
      "@platform/files": ["../../../modules/files/frontend/src/index.ts"],
      "@platform/files/*": ["../../../modules/files/frontend/src/*"],
      "@platform/orgs": ["../../../modules/orgs/frontend/src/index.ts"],
      "@platform/orgs/*": ["../../../modules/orgs/frontend/src/*"],
      "zod": ["node_modules/zod"],
      "react-hook-form": ["node_modules/react-hook-form"],
      "@hookform/resolvers": ["node_modules/@hookform/resolvers"],
      "@hookform/resolvers/*": ["node_modules/@hookform/resolvers/*"],
      "@microsoft/signalr": ["node_modules/@microsoft/signalr"],
      "axios": ["node_modules/axios"],
      "lucide-react": ["node_modules/lucide-react"],
      "primereact/*": ["node_modules/primereact/*"],
      "react": ["node_modules/@types/react/index.d.ts"],
      "react/*": ["node_modules/@types/react/*"]
    },

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "../../../modules/settings/frontend/src",
    "../../../modules/files/frontend/src",
    "../../../modules/orgs/frontend/src",
    "../../../frameworks/frontend/src"
  ]
}
