{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@platform/core": ["../../../frameworks/frontend/src/index.ts"],
      "@platform/core/*": ["../../../frameworks/frontend/src/*"],
      "@platform/notifications": [
        "../../../modules/notifications/frontend/src/features/notifications/index.ts"
      ],
      "@platform/setting": ["../../../modules/settings/frontend/src/index.ts"],
      "@platform/setting/*": ["../../../modules/settings/frontend/src/*"],
      "@platform/files": ["../../../modules/files/frontend/src/index.ts"],
      "@platform/files/*": ["../../../modules/files/frontend/src/*"],
      "@platform/importexport": ["../../../modules/importexport/frontend/src/index.ts"],
      "@platform/importexport/*": ["../../../modules/importexport/frontend/src/*"],
      "@platform/orgs": ["../../../modules/orgs/frontend/src/index.ts"],
      "@platform/orgs/*": ["../../../modules/orgs/frontend/src/*"],
      "@platform/identity": ["../../../modules/identity/frontend/src/index.ts"],
      "@platform/identity/*": ["../../../modules/identity/frontend/src/*"],
      "@platform/orgstructure": ["../../../modules/orgstructure/frontend/src/index.ts"],
      "@platform/orgstructure/*": ["../../../modules/orgstructure/frontend/src/*"],
      "@tanstack/react-query": ["../../../modules/identity/frontend/node_modules/@tanstack/react-query"],
      "zod": ["../../../frameworks/frontend/node_modules/zod"],
      "react-hook-form": ["../../../frameworks/frontend/node_modules/react-hook-form"],
      "@hookform/resolvers": ["../../../frameworks/frontend/node_modules/@hookform/resolvers"],
      "@hookform/resolvers/*": ["../../../frameworks/frontend/node_modules/@hookform/resolvers/*"],
      "axios": ["../../../frameworks/frontend/node_modules/axios"],
      "lucide-react": ["../../../frameworks/frontend/node_modules/lucide-react"],
      "primereact": ["../../../frameworks/frontend/node_modules/primereact"],
      "primereact/*": ["../../../frameworks/frontend/node_modules/primereact/*"],
      "@primereact/core": ["../../../frameworks/frontend/node_modules/@primereact/core"],
      "@primereact/core/*": ["../../../frameworks/frontend/node_modules/@primereact/core/*"],
      "@primereact/types": ["../../../frameworks/frontend/node_modules/@primereact/types"],
      "@primereact/types/*": ["../../../frameworks/frontend/node_modules/@primereact/types/*"],
      "@primeuix/themes": ["../../../frameworks/frontend/node_modules/@primeuix/themes"],
      "@primeuix/themes/*": ["../../../frameworks/frontend/node_modules/@primeuix/themes/*"],
      "@primeuix/styled": ["../../../frameworks/frontend/node_modules/@primeuix/styled"],
      "react-router-dom": ["../../../frameworks/frontend/node_modules/react-router-dom"],
      "react-toastify": ["../../../frameworks/frontend/node_modules/react-toastify"],
      "react": ["../../../frameworks/frontend/node_modules/@types/react/index.d.ts"],
      "react/*": ["../../../frameworks/frontend/node_modules/@types/react/*"]
    },

    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "../../../modules/settings/frontend/src",
    "../../../modules/files/frontend/src",
    "../../../modules/importexport/frontend/src",
    "../../../modules/orgs/frontend/src",
    "../../../modules/identity/frontend/src",
    "../../../modules/orgstructure/frontend/src",
    "../../../frameworks/frontend/src"
  ]
}
