<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <SpaRoot>clients\web\</SpaRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
    <SpaProxyServerUrl>http://127.0.0.1:5173</SpaProxyServerUrl>
    <SpaProxyLaunchCommand>npm run dev:spa</SpaProxyLaunchCommand>
    <SpaProxyTimeoutInSeconds>180</SpaProxyTimeoutInSeconds>
    <SkipFrontendBuild>false</SkipFrontendBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.20">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.15.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.StackExchangeRedis" Version="1.15.1-beta.1" />
    <PackageReference Include="StackExchange.Redis" Version="2.7.33" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't publish client source; show it in Solution Explorer -->
    <Content Remove="$(SpaRoot)**" />
    <None Remove="$(SpaRoot)**" />
    <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\frameworks\Platform.OpenTelemetry\Platform.OpenTelemetry.csproj" />
    <ProjectReference Include="..\frameworks\Platform.OpenTelemetry.DDD\Platform.OpenTelemetry.DDD.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Swashbuckle\Platform.Swashbuckle.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Mvc\Platform.Mvc.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Caching.Redis\Platform.Caching.Redis.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Authentication\Platform.Authentication.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Authentication.Jwt\Platform.Authentication.Jwt.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Authentication.ApiKey\Platform.Authentication.ApiKey.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Authentication.Basic\Platform.Authentication.Basic.csproj" />
    <ProjectReference Include="..\frameworks\Platform.BlobStoring\Platform.BlobStoring.csproj" />
    <ProjectReference Include="..\frameworks\Platform.BlobStoring.MinIO\Platform.BlobStoring.MinIO.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Authentication.Cognito\Platform.Authentication.Cognito.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Authorization\Platform.Authorization.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Authorization.EntityFramework\Platform.Authorization.EntityFramework.csproj" />
    <ProjectReference Include="..\frameworks\Platform.ORM.EntityFramework\Platform.ORM.EntityFramework.csproj" />
    <ProjectReference Include="..\frameworks\Platform.ORM.Dapper\Platform.ORM.Dapper.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Multitenancy\Platform.Multitenancy.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Multitenancy.EntityFramework\Platform.Multitenancy.EntityFramework.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Notification.Mailkit\Platform.Notification.Mailkit.csproj" />
    <ProjectReference Include="..\frameworks\Platform.HealthChecks\Platform.HealthChecks.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Workflow\Platform.Workflow.csproj" />
    <ProjectReference Include="..\modules\settings\Platform.Modules.Setting\Platform.Modules.Setting.csproj" />
    <ProjectReference Include="..\modules\settings\Platform.Modules.Setting.API\Platform.Modules.Setting.API.csproj" />
    <ProjectReference Include="..\modules\settings\Platform.Modules.Setting.EntityFramework\Platform.Modules.Setting.EntityFramework.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Realtime\Platform.Realtime.csproj" />
    <ProjectReference Include="..\frameworks\Platform.Realtime.SignalR\Platform.Realtime.SignalR.csproj" />
    <ProjectReference Include="..\modules\notifications\Platform.Modules.Notifications\Platform.Modules.Notifications.csproj" />
    <ProjectReference Include="..\modules\notifications\Platform.Modules.Notifications.Redis\Platform.Modules.Notifications.Redis.csproj" />
    <ProjectReference Include="..\modules\notifications\Platform.Modules.Notifications.Api\Platform.Modules.Notifications.Api.csproj" />
    <ProjectReference Include="..\modules\workflows\Platform.Modules.Workflow.Api\Platform.Modules.Workflow.Api.csproj" />
    <ProjectReference Include="..\modules\workflows\Platform.Modules.Workflow.EntityFramework\Platform.Modules.Workflow.EntityFramework.csproj" />
  </ItemGroup>

  <Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules') And '$(SkipFrontendBuild)' != 'true'">
    <Exec Command="node --version" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
    </Exec>
    <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run the Sample frontend. Install from https://nodejs.org/ and restart the terminal." />
    <Message Importance="high" Text="Restoring Sample web client dependencies (npm install)..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
  </Target>

  <!--
    tsconfig paths compile linked packages from source; each needs its own node_modules.
    Runs before SPA build/publish when node_modules is missing.
  -->
  <Target Name="EnsureLinkedFrontendDeps" BeforeTargets="DebugBuildFrontend;PublishRunWebpack" Condition="'$(SkipFrontendBuild)' != 'true'">
    <ItemGroup>
      <_FrontendPackageJson Include="$(MSBuildProjectDirectory)\..\frameworks\frontend\package.json" />
      <_FrontendPackageJson Include="$(MSBuildProjectDirectory)\..\modules\*\frontend\package.json" />
      <LinkedFrontendPackage Include="@(_FrontendPackageJson->'%(RootDir)%(Directory)')" />
    </ItemGroup>
    <Message Importance="high" Text="Restoring linked frontend dependencies in %(LinkedFrontendPackage.Identity) (npm install)..." Condition="!Exists('%(LinkedFrontendPackage.Identity)\node_modules')" />
    <Exec WorkingDirectory="%(LinkedFrontendPackage.Identity)" Command="npm install" Condition="!Exists('%(LinkedFrontendPackage.Identity)\node_modules')" />
  </Target>

  <!--
    One-command run: build SPA into wwwroot on Debug build (no SpaProxy).
    Skip with: -p:SkipFrontendBuild=true
  -->
  <Target Name="DebugBuildFrontend" AfterTargets="DebugEnsureNodeEnv" BeforeTargets="Build" Condition="'$(Configuration)' == 'Debug' And '$(SkipFrontendBuild)' != 'true'">
    <Message Importance="high" Text="Building Sample web client into wwwroot..." />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
  </Target>

  <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
    <ItemGroup>
      <DistFiles Include="wwwroot\**" Exclude="wwwroot\.gitignore" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
