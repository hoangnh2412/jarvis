{
  // Workflow (Elsa): Enabled = false để tắt toàn bộ workflow trong Sample.
  // Embedded: Sample chạy engine + persistence + API + Studio (tự migrate schema Elsa).
  "Elsa": {
    "Enabled": false,
    "Mode": "Embedded",
    "ConnectionStringName": "MasterDbContext",
    "PersistenceSchema": "elsa",
    "ApiPathPrefix": "/elsa/api",
    "BaseUrl": "https://localhost:7000"
  },
  // Standalone: Sample là client, gọi một Workflow Server khác (ví dụ một Sample khác chạy Embedded).
  //"Elsa": {
  //  "Enabled": true,
  //  "Mode": "Standalone",
  //  "BaseUrl": "https://workflow-server:7000",
  //  "StudioUrl": "https://workflow-server:7000",
  //  "ApiPathPrefix": "/elsa/api"
  //},
  "ConnectionStrings": {
    "AutoMigrate": "true",
    "MasterDbContext": "Host=localhost;Port=5432;User ID=admin;Password=Admin@123;Database=SampleMaster;Pooling=true;",
    "TenantDbContext": "Host=localhost;Port=5432;User ID=admin;Password=Admin@123;Database=SampleTenant;Pooling=true;"
  },
  "ExcelEngine": {
    "MaxFileSizeBytes": 52428800,
    "MaxRowCount": 1000000,
    "MaxColumnCount": 500,
    "ImportTimeoutSeconds": 300,
    "ExportTimeoutSeconds": 300,
    "HostTimeoutPaddingSeconds": 60,
    "HostRequestTimeoutSeconds": 0,
    "PersistBatchSize": 2000,
    "IncludeRowsInResponse": true,
    "IncludeRowsMaxRowCount": 10000,
    "TemplateFilesRoot": "template-files",
    "SupportedExtensions": [ ".xlsx", ".csv" ]
  },
  "Cache": {
    "DefaultDistributedGroup": "Default",
    "DefaultDistributedType": "Redis",
    "MemoryInvalidation": {
      "Redis": {
        "Configuration": "localhost:6379,password=Admin@123",
        "Note": "Dedicated pub/sub for cross-node memory invalidation - not shared with DistributedGroups"
      }
    },
    "DistributedGroups": {
      "Redis": {
        "Default": {
          "Configuration": "localhost:6379,password=Admin@123",
          "InstanceName": "Instance1_"
        },
        "Auth": {
          "Configuration": "localhost:6379,password=Admin@123",
          "InstanceName": "SharedAuth1_"
        },
        "Big": {
          "Configuration": "localhost:6379,password=Admin@123",
          "InstanceName": "Instance3_"
        },
        "Notifications": {
          "Configuration": "127.0.0.1:6379,abortConnect=false,connectTimeout=5000,syncTimeout=5000",
          "InstanceName": "Notifications1_"
        }
      }
    },
    "Items": {
      "ContextData": {
        "Key": "context:{sid}",
        "DistributedSeconds": 14400,
        "MemSeconds": 180,
        "DistributedGroup": "Auth",
        "Note": "Session context - memory + Redis Auth cluster"
      },
      "ConnectionString": {
        "Key": "conn:{dbid}",
        "MemSeconds": 14400,
        "Note": "Connection string - memory only"
      },
      "ProductDemo": {
        "Key": "Product:{tenantId}:{id}",
        "MemSeconds": 300,
        "DistributedSeconds": 3600,
        "DistributedGroup": "Default",
        "Note": "Product cache demo - memory + Redis Default cluster"
      },
      "Setting": {
        "Key": "setting:{tenantId}:{key}",
        "MemSeconds": 300,
        "DistributedSeconds": 3600,
        "DistributedGroup": "Default",
        "Note": "Setting value by tenant + key"
      },
      "AuthUserInfo": {
        "Key": "Auth:UserInfo:{uname}:{appType}",
        "DistributedGroup": "Auth",
        "MemSeconds": 180,
        "DistributedSeconds": 14400,
        "Note": "Logged-in user by username"
      }
    }
  },
  "Encryption": {
    "DataEncryptionKey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
  },
  "Realtime": {
    "ClientMethodName": "notification",
    "Redis": {
      "Configuration": "127.0.0.1:6379"
    },
    "SignalR": {
      "Enabled": true,
      "SignalRPath": "/hubs/notifications",
      "UseRedisBackplane": false,
      "ChannelPrefix": "platform-realtime-signalr"
    },
    "Sse": {
      "Enabled": true,
      "SsePath": "/sse/notifications",
      "HeartbeatSeconds": 15,
      "UseRedisFanOut": false,
      "ChannelPrefix": "platform-realtime-sse",
      "AllowAccessTokenQuery": false
    }
  },
  "Authentication": {
    "DefaultScheme": "Basic",
    "DefaultAuthenticateScheme": "ApiKey",
    "DefaultChallengeScheme": "ApiKey",
    "DefaultSignInScheme": null,
    "DefaultSignOutScheme": null,
    "DefaultForbidScheme": null,
    "RequireAuthenticatedSignIn": false,
    "Schemes": {
      "Bearer": {
        "Enabled": true,
        "Profile": "Default",
        "Profiles": {
          "Default": {
            "Source": "Storage",
            "Authority": null,
            "Audience": "client",
            "RequireHttpsMetadata": false,
            "IssuerSigningKeys": [
              "sample-dev-jwt-signing-key-minimum-32b"
            ],
            "ValidateActor": false,
            "ValidateSignatureLast": true,
            "ValidateWithLKG": false,
            "ValidateTokenReplay": false,
            "ValidateAudience": true,
            "ValidAudiences": [],
            "ValidateIssuerSigningKey": true,
            "ValidateIssuer": false,
            "ValidIssuers": [],
            "MaxExpireMinutes": 0
          }
        }
      },
      "ApiKey": {
        "Enabled": true,
        "Profile": "Default",
        "Profiles": {
          "Default": {
            "Source": "Storage",
            "KeyName": "X-API-KEY"
          },
          "Integration": {
            "Source": "Configuration",
            "KeyName": "X-API-KEY",
            "Key": "hahaha"
          }
        }
      },
      "Basic": {
        "Enabled": false,
        "Profile": "Default",
        "Profiles": {
          "Default": {
            "Source": "Storage",
            "Realm": "Basic Authentication"
          }
        }
      }
    },
    "PasswordPolicy": {
      "Source": "Storage",
      "Defaults": {
        "MinLength": 8,
        "RequireDigit": true,
        "RequireUppercase": false,
        "RequireLowercase": true,
        "RequireNonAlphanumeric": false,
        "MaxFailedAttempts": 5
      }
    }
  },
  "Json": {
    "IgnoreNull": true,
    "NamingPolicy": "CamelCase"
  },
  "Swagger": {
    "Enable": true,
    "Versions": [
      "v1",
      "v2"
    ],
    "ApiKeyHeaderName": "X-API-KEY",
    "ApiResponseDocumentationPathPrefixes": [
      "/api"
    ],
    "SecuritySchemes": [
      "JWT",
      "API_KEY"
    ]
  },
  "Middlewares": {
    "ApiResponseWrapper": {
      "IsEnable": true,
      "Includes": [
        "^/api"
      ],
      "Excludes": [
        "^.*\\.js$",
        "^.*\\.css$",
        "^.*\\/health$",
        "^.*\\/swagger$"
      ]
    }
  },
  "Cors": {
    "Default": {
      "AllowAnyOrigin": true,
      "AllowedOrigins": [],
      "AllowedAllHeaders": true,
      "AllowedHeaders": [],
      "AllowedAllMethods": true,
      "AllowedMethods": [],
      "AllowCredentials": false
    }
  },
  "OTEL": {
    "Name": "sample-code",
    "Namespace": "sample-code-namespace",
    "InstanceId": "hoangnh",
    "Resource": {
      "IncludeHostDetector": true,
      "IncludeContainerDetector": true
    },
    "Attributes": {},
    "Logging": {
      "IncludeConsoleExporter": false,
      "Endpoint": "http://localhost:14317",
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true
    },
    "Tracing": {
      "Endpoint": "http://localhost:14317",
      "Sampler": "ParentBasedRatio",
      "TraceIdRatio": 1.0,
      "TimeoutMilliseconds": 10000,
      "BatchExportProcessorOptions": {
        "ScheduledDelayMilliseconds": 5000
      },
      "HttpTraceEnrichment": {
        "CaptureRequestHeaders": true,
        "CaptureResponseHeaders": true,
        "AllowedRequestHeaderNames": [
          "traceparent",
          "tracestate",
          "x-request-id",
          "x-correlation-id",
          "x-demo-request"
        ],
        "AllowedResponseHeaderNames": [
          "content-type",
          "api-supported-versions",
          "x-demo-response"
        ],
        "MaxHeaderValueLength": 256
      },
      "AspNetCoreInstrumentation": {
        "RecordException": true,
        "ExcludedPathPrefixes": [
          "/health",
          "/healthchecks",
          "/swagger"
        ]
      },
      "HttpClient": {
        "ExcludedUrlSubstrings": []
      }
    },
    "Metric": {
      "Endpoint": "http://localhost:14317",
      "HistogramAggregation": "explicit",
      "IncludeConsoleExporter": false
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/sample-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "HealthChecks": {
    "MemoryThresholdPercent": 80,
    "CpuThresholdPercent": 90,
    "ResultCacheMilliseconds": 100,
    "DetailedEndpointApiKey": "",
    "EnablePrometheusMetrics": true,
    "PrometheusMetricsPath": "/health/prometheus",
    "DefaultTimeoutSeconds": 5,
    "MarkStartupCompleteOnApplicationStarted": true,
    "Ui": {
      "Enabled": true,
      "EvaluationTimeSeconds": 10,
      "UIPath": "/healthchecks-ui",
      "ApiPath": "/healthchecks-api",
      "Endpoints": [
        {
          "Name": "Startup",
          "Uri": "http://localhost:5167/health/startup"
        },
        {
          "Name": "Liveness",
          "Uri": "http://localhost:5167/health/live"
        },
        {
          "Name": "Readiness",
          "Uri": "http://localhost:5167/health/ready"
        }
      ],
      "Webhooks": []
    },
    "Readiness": {
      "MasterDatabase": "ConnectionStrings:MasterDbContext",
      "TenantDatabase": "ConnectionStrings:TenantDbContext",
      "Redis": "Cache:DistributedGroups:Redis:Default:Configuration"
    }
  },
  "BlobStoring": {
    "DefaultProvider": "FileSystem",
    "FileSystem": {
      "RootPath": "",
      "SubPath": "",
      "AutoSelectPriority": 10
    },
    "MinIO": {
      "Endpoint": "",
      "AccessKey": "",
      "SecretKey": "",
      "UseSsl": false,
      "AutoSelectPriority": 30
    },
    "AwsS3": {
      "Region": "",
      "BucketName": "",
      "AccessKey": "",
      "SecretKey": "",
      "AutoSelectPriority": 20
    },
    "SharePoint": {
      "TenantId": "",
      "ClientId": "",
      "ClientSecret": "",
      "DriveId": "",
      "ViewLinkScope": "organization",
      "AutoSelectPriority": 25
    },
    "Synology": {
      "Host": "",
      "Port": 443,
      "UseHttps": true,
      "Username": "",
      "Password": "",
      "IgnoreSslErrors": true,
      "RootPath": "",
      "AutoSelectPriority": 23
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Trace",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}