{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "application/**/*.ts",
    "integrations/**/*.ts",
    "composition/**/*.ts",
    "ui/**/*.ts",
    "config/**/*.ts",
    "drivers/**/*.ts",
    "tests/**/*.ts"
  ]
}
